        "assignments": {
          "assignments": [
            {
              "id": "2e08df1f-e3d7-56bc-f71e-76f2816a5771",
              "name": "html",
              "value": "=<!DOCTYPE html>\n<html lang=\"he\" dir=\"rtl\">\n<head>\n<meta charset=\"utf-8\">\n<title>חשבונית מס {{ ($json.fields || $json).InvoiceNumber }}</title>\n<style>\nbody { font-family: Arial, 'Segoe UI', sans-serif; direction: rtl; margin: 0; padding: 32px; color: #1a1a1a; background: #fff; }\n.doc { max-width: 760px; margin: 0 auto; border: 1px solid #dcdcdc; padding: 32px; }\n.head { display: flex; justify-content: space-between; align-items: flex-start; border-bottom: 3px solid #1f4e79; padding-bottom: 16px; }\n.biz-name { font-size: 24px; font-weight: bold; color: #1f4e79; margin: 0 0 6px; }\n.biz-meta { font-size: 13px; color: #555; line-height: 1.7; }\n.doc-title { font-size: 20px; font-weight: bold; text-align: left; }\n.doc-num { font-size: 15px; color: #1f4e79; text-align: left; margin-top: 6px; }\n.section { margin-top: 26px; }\n.label { font-size: 12px; color: #777; letter-spacing: .5px; }\n.value { font-size: 15px; font-weight: bold; }\ntable { width: 100%; border-collapse: collapse; margin-top: 14px; font-size: 14px; }\nth { background: #1f4e79; color: #fff; text-align: right; padding: 10px 12px; font-weight: normal; }\ntd { border-bottom: 1px solid #eee; padding: 10px 12px; }\n.num { text-align: left; font-variant-numeric: tabular-nums; }\n.totals { margin-top: 18px; margin-right: auto; width: 320px; font-size: 14px; }\n.totals div { display: flex; justify-content: space-between; padding: 7px 0; border-bottom: 1px solid #eee; }\n.grand { font-size: 18px; font-weight: bold; color: #1f4e79; border-bottom: 3px double #1f4e79; }\n.foot { margin-top: 34px; font-size: 12px; color: #777; line-height: 1.8; border-top: 1px solid #eee; padding-top: 14px; }\n.stamp { display: inline-block; margin-top: 10px; padding: 5px 12px; border: 2px solid #1f4e79; color: #1f4e79; font-size: 12px; font-weight: bold; }\n</style>\n</head>\n<body>\n<div class=\"doc\">\n  <div class=\"head\">\n    <div>\n      <p class=\"biz-name\">איי.איי אלקטרוניקה בע\"מ</p>\n      <div class=\"biz-meta\">\n        ח.פ. 515123456 · עוסק מורשה<br>\n        רח' הברזל 12, תל אביב<br>\n        טלפון: 03-7654321 · info@ai-electronics.co.il\n      </div>\n    </div>\n    <div>\n      <div class=\"doc-title\">חשבונית מס</div>\n      <div class=\"doc-num\">מספר: {{ ($json.fields || $json).InvoiceNumber }}</div>\n      <div class=\"doc-num\">תאריך: {{ $json.IssueDate }}</div>\n    </div>\n  </div>\n\n  <div class=\"section\">\n    <div class=\"label\">לכבוד</div>\n    <div class=\"value\">{{ ($json.fields || $json).CustomerId }}</div>\n  </div>\n\n  <div class=\"section\">\n    <table>\n      <tr><th>תיאור</th><th class=\"num\">כמות</th><th class=\"num\">מחיר לפני מע\"מ</th><th class=\"num\">סה\"כ</th></tr>\n      <tr>\n        <td>אספקת מוצרים ושירותים — הזמנה {{ ($json.fields || $json).InvoiceNumber }}</td>\n        <td class=\"num\">1</td>\n        <td class=\"num\">{{ $json.AmountFmt }} ₪</td>\n        <td class=\"num\">{{ $json.AmountFmt }} ₪</td>\n      </tr>\n    </table>\n  </div>\n\n  <div class=\"totals\">\n    <div><span>סכום לפני מע\"מ</span><span class=\"num\">{{ $json.AmountFmt }} ₪</span></div>\n    <div><span>מע\"מ {{ $json.VatPercent }}%</span><span class=\"num\">{{ $json.VatFmt }} ₪</span></div>\n    <div class=\"grand\"><span>סה\"כ לתשלום</span><span class=\"num\">{{ $json.TotalFmt }} ₪</span></div>\n  </div>\n\n  <div class=\"foot\">\n    מסמך זה הופק ממערכת ממוחשבת. סטטוס תשלום: {{ $json.PayStatus }}.<br>\n    מע\"מ בשיעור {{ $json.VatPercent }}% בהתאם לשיעור החוקי במועד העסקה (18% החל מ-01/01/2025, 17% לפני כן).<br>\n    יש לשמור מסמך זה לצורכי דיווח לרשויות המס.\n    <div class=\"stamp\">מקור</div>\n  </div>\n</div>\n</body>\n</html>\n",
