    {
      "parameters": {
        "promptType": "define",
        "text": "={{ 'כתוב מייל מכירה קר, קצר וידידותי, בעברית תקנית, אל ליד עסקי בשם: ' + ($json.fields || $json).Name + ' (חברה: ' + (($json.fields || $json).Company || 'לא צוינה') + '). אנחנו איי.איי אלקטרוניקה (AI Electronics), קמעונאית אלקטרוניקה ישראלית שמוכרת אוזניות, מסכים, מקלדות, עכברים, רמקולים, מצלמות רשת ואביזרי מחשב, עם אחריות יבואן רשמי ומשלוח מהיר. כללים: פנייה אישית בשם; משפט פתיחה אחד שמסביר למה פנינו; שתי נקודות ערך לכל היותר; קריאה לפעולה אחת וברורה (השבה למייל הזה); עד 120 מילים; בלי הבטחות מחיר; בלי אימוג\\'ים; בלי נושא — רק גוף המייל; חתימה: צוות המכירות, איי.איי אלקטרוניקה.' }}"
      },
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.5,
